--swiftversion 6.2
--indent 4
--maxwidth 100
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas inline
--exclude .build

# swiftTestingTestCaseNames backtick-quotes camelCase test names,
# which conflicts with the sentence-name convention in CLAUDE.md.
--disable swiftTestingTestCaseNames
